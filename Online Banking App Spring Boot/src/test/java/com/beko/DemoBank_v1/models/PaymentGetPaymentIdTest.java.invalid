import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

class ExampleTest {

// This test method checks addition.
// It adds two numbers: 2 and 3.
    @Test
    void testAddition() {
        // Perform addition: 2 + 3.
        int result = 2 + 3;
        // Assert that result equals 5.
        assertEquals(5, result);
    }

// This test method checks subtraction.
// It subtracts 2 from 5.
    @Test
    void testSubtraction() {
        // Perform subtraction: 5 - 2.
        int result = 5 - 2;
        // Assert that result equals 3.
        assertEquals(3, result);
    }

// This test method checks multiplication.
// It multiplies two numbers: 3 and 4.
    @Test
    void testMultiplication() {
        // Perform multiplication: 3 * 4.
        int result = 3 * 4;
        // Assert that result equals 12.
        assertEquals(12, result);
    }

// This test method checks division.
// It divides 12 by 3.
    @Test
    void testDivision() {
        // Perform division: 12 / 3.
        int result = 12 / 3;
        // Assert that result equals 4.
        assertEquals(4, result);
    }
}
